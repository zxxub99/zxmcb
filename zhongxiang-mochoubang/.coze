[project]
sub_id = "cd7d4069"
name = "钟祥莫愁帮"
requires = ["nodejs-24", "python-3.11"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/coze-preview-build.sh"]
run = ["bash", "scripts/coze-preview-run.sh"]

[deploy]
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[subprojects]
path = ["."]
