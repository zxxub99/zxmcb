[project]
sub_id = "a1b2c3d4"
name = "zhongxiang-mochoubang-frontend"
requires = ["nodejs-24"]
project_type = "web"
entrypoint = "."

[preview]
preview_enable = "enabled"

[deploy]
profile = { kind = "service", flavor = "web" }
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[dev]
build = ["bash", "scripts/coze-preview-build.sh"]
run = ["bash", "scripts/coze-preview-run.sh"]
