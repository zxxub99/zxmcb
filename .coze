[project]
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-preview-build.sh"]
run = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-preview-run.sh"]

[deploy]
profile = { kind = "service", flavor = "web" }
build = ["pnpm", "run", "build"]
run = ["pnpm", "run", "start"]

[subprojects]
path = ["zhongxiang-mochoubang"]
