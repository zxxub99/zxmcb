[project]
sub_id = "a1b2c3d4"
name = "钟祥莫愁帮"
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "frontend/scripts/coze-preview-build.sh"]
run = ["bash", "frontend/scripts/coze-preview-run.sh"]

[deploy]
build = ["bash", "-c", "cd frontend && pnpm run build"]
run = ["bash", "-c", "cd frontend && pnpm run serve"]
