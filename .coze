[project]
entrypoint = "zhongxiang-mochoubang/frontend"
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-preview-build.sh"]
run = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-preview-run.sh"]

[deploy]
profile = { kind = "service", flavor = "web" }
build = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-deploy-build.sh"]
run = ["bash", "zhongxiang-mochoubang/frontend/scripts/coze-deploy-run.sh"]

[subprojects]
path = ["zhongxiang-mochoubang"]
