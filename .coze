[project]
sub_id = "a1b2c3d4"
name = "钟祥莫愁帮"
requires = ["nodejs-24"]
project_type = "web"
entrypoint = "frontend/dist/index.html"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "frontend/scripts/coze-preview-build.sh"]
run = ["bash", "frontend/scripts/coze-preview-run.sh"]

[deploy.profile]
kind = "static"
flavor = "web"

[deploy]
build = ["bash", "frontend/scripts/coze-deploy-build.sh"]
run = ["echo", "static site deployed"]

[subprojects]
path = ["."]
